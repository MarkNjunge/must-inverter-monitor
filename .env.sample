SERPORT = 'COM3' # e.g. `COM3` in Windows, `/dev/ttyUSB0` in Linux
SERTIMEOUT = 0.5
SERBAUD = 19200

INTERVAL = 1 # Interval between reading statistics. In seconds.
INFINITE = true # Set to false to run only once and exit.

# Optional InfluxDB
# https://docs.influxdata.com/influxdb/v2/install/?t=Docker
INFLUX_ENABLED = false
INFLUX_HOST = 'http://127.0.0.1:8086'
INFLUX_ORGID = 'org_id'
INFLUX_BUCKET = 'bucket'
INFLUX_TOKEN = 'token'
